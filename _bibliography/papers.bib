  website={https://github.com/VectorInstitute/fairsense-agentix},
  code={https://github.com/VectorInstitute/fairsense-agentix},
  selected={true},
  bibtex_show={true}
}

@inproceedings{chaduvula2026xai,
  abbr={FTC},
  title={From Features to Actions: Explainability in Traditional and Agentic {AI} Systems},
  author={Chaduvula, Sindhuja and Ho, Jessee and Kim, Kina and Narayanan, Aravind and Radwan, Ahmed Y. and Alinoori, Mahshid and Garg, Muskan and Ramachandram, Dhanesh and Raza, Shaina},
  booktitle={Future Technologies Conference (FTC)},
  year={2026},
  abstract={Over the last decade, Explainable AI has primarily focused on interpreting individual model predictions, producing post-hoc explanations that relate inputs to outputs under a fixed decision structure. Recent advances in large language models have enabled agentic AI systems whose behaviour unfolds over multi-step trajectories. We compare attribution-based explanations with trace-based diagnostics across both settings, and show that while attribution methods achieve stable feature rankings in static settings, they cannot be applied reliably to diagnose execution-level failures in agentic trajectories.},
  arxiv={2602.06841},
  pdf={https://arxiv.org/pdf/2602.06841},
  website={https://vectorinstitute.github.io/unified-xai-evaluation-framework/},
  bibtex_show={true}
}

@inproceedings{narayanan2025bias,
  abbr={NeurIPS W},
  title={Bias in the Picture: Benchmarking {VLMs} with Social-Cue News Images and {LLM}-as-Judge Assessment},
  author={Narayanan, Aravind and Khazaie, Vahid Reza and Raza, Shaina},
  booktitle={NeurIPS 2025 Workshop on Evaluating the Evolving LLM Lifecycle},
  year={2025},
  abstract={Large vision-language models can jointly interpret images and text, but they are also prone to absorbing and reproducing harmful social stereotypes when visual cues such as age, gender, race, clothing, or occupation are present. We introduce a news-image benchmark of 1,343 image-question pairs annotated with ground-truth answers and demographic attributes, and evaluate state-of-the-art VLMs with an LLM-as-judge protocol. Visual context systematically shifts model outputs, bias prevalence varies across attributes, and higher faithfulness does not necessarily correspond to lower bias.},
  arxiv={2509.19659},
  pdf={https://arxiv.org/pdf/2509.19659},
  bibtex_show={true}
}

@inproceedings{raval2025linguamark,
  abbr={ASONAM},
  title={{LinguaMark}: Do Multimodal Models Speak Fairly? A Benchmark-Based Evaluation},
  author={Raval, Ananya and Narayanan, Aravind and Khazaie, Vahid Reza and Raza, Shaina},
  booktitle={International Conference on Advances in Social Networks Analysis and Mining (ASONAM)},
  year={2025},
  abstract={Large multimodal models are typically trained on vast image-text corpora but remain limited in linguistic coverage, leading to biased and unfair outputs across languages. LinguaMark evaluates LMMs on multilingual visual question answering with 6,875 image-text pairs spanning 11 languages and five social attributes, using Bias, Answer Relevancy, and Faithfulness as complementary metrics.},
  arxiv={2507.07274},
  pdf={https://arxiv.org/pdf/2507.07274},
  website={https://vectorinstitute.github.io/linguamark/},
  code={https://github.com/VectorInstitute/LinguaMark},
  additional_info={Also presented at the NeurIPS 2025 LLM Evaluation Workshop.},
  bibtex_show={true}
}
